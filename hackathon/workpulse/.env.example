# WorkPulse — environment variables (names only; never commit real secrets)
# Copy to .env.local for local development:
#   cp .env.example .env.local

# --- AI (server-side only — used in API routes) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# --- Adzuna job search (server-side only — SECRET credential pair) ---
# ADZUNA_APP_ID is NOT public; keep server-side (do not use NEXT_PUBLIC_ prefix)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# --- Optional Supabase (not required for hackathon demo) ---
# When unset, the app uses browser localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
